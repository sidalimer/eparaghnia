generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  revenuMensuel  Float    @default(2000)

  firstName       String?
  lastName        String?

  recurringExpenses  RecurringExpense[]
  necessaryBudgets   NecessaryBudget[]
  savingGoals        SavingGoal[]
  transactions       Transaction[]
}

model RecurringExpense {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Float
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}

model NecessaryBudget {
  id        Int      @id @default(autoincrement())
  category  String
  weeklyAmount Float
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}

model SavingGoal {
  id        Int      @id @default(autoincrement())
  targetAmount Float
  user      User     @relation(fields: [userId], references: [id])
  userId    Int      @unique
  createdAt DateTime @default(now())
}

model Transaction {
  id        Int      @id @default(autoincrement())
  label     String
  amount    Float
  date      DateTime
  category  String
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
}
